# Пароль Postgres (внутри docker-сети, наружу не торчит)
POSTGRES_PASSWORD=change-me
# Ключ шифрования секретов в БД (TOTP, позже токены Telegram и Remnawave). Не менять после первого запуска!
# Сгенерировать: openssl rand -hex 32
APP_SECRET=
# Адрес панели, как его видят мосты. Попадает в install.sh, поэтому задаётся явно.
PUBLIC_URL=https://panel.example.com
# Порт на localhost, куда смотрит Caddy
PANEL_PORT=3000
# Приватный ключ подписи агентов (создаётся командой `make keygen` в agent/). Нужен для обновления агентов по кнопке.
# Без него панель собирается, но агентов по кнопке не обновить. Файл храните вне репозитория.
AGENT_SIGNING_KEY=
